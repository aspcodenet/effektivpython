@dataclass
class Player:
    id: str
    age: int
    namn: str
    teamname: str
    games: int
    goals: int
    ass: int
    positions: str

    def __init__(self, id, age, namn, teamname, games, goals, ass, positions):
        self.id = id
        self.namn = namn
        self.teamname = teamname
        self.games = games
        self.goals = goals
        self.ass = ass
        self.positions = positions


def GetOldestAndYoungest(allPlayers:list[Player]):
    youngestSoFar = allPlayers[0]
    oldestSoFar = allPlayers[0]
    for player in allPlayers:
        if player.age < youngestSoFar.age:
            youngestSoFar = player
        if player.age > oldestSoFar.age:
            oldestSoFar = player
    return youngestSoFar, oldestSoFar

