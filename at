def getMin(listOfNumbers: list) -> int:
    youngestSoFar = listOfNumbers[0]
    for number in listOfNumbers:
        if number < youngestSoFar:
            youngestSoFar = number
    return youngestSoFar

def getMax(listOfNumbers: list) -> int:
    oldestSoFar = listOfNumbers[0]
    for number in listOfNumbers:
        if number > oldestSoFar:
            oldestSoFar = number
    return oldestSoFar

