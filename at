def timing_decorator(funktionsAliaset):
    def wrapper(*args, **kwargs):
        start = default_timer()
        x = funktionsAliaset(*args, **kwargs)
        end = default_timer()
        print(f"Det tog {end-start}")
        return x 
    return wrapper


def print_decorator(funktionsAliaset):
    def wrapper(*args, **kwargs):
        print("Starting")
        x = funktionsAliaset(*args, **kwargs)
        print("Ending")
        return x 
    return wrapper

@timing_decorator
@print_decorator
